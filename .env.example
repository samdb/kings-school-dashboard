# Optional overrides — export these in your shell before `python3 run.py`.
# (The app does not read .env files itself; this is documentation only.)

# Helper executable (absolute path or name on PATH)
KINGSDASH_GOG_BIN=gog-authenticated
# Port on 127.0.0.1 (the server never binds any other interface)
KINGSDASH_PORT=8765
# Where private data lives (default: ./data)
# KINGSDASH_DATA_DIR=/path/to/private/dir
# Per-command timeout, seconds
KINGSDASH_COMMAND_TIMEOUT=45
# Search pages of 50 threads to read per account, and an overall thread cap
KINGSDASH_MAX_PAGES=4
KINGSDASH_MAX_THREADS=200
# Total time budget for one refresh, seconds
KINGSDASH_REFRESH_BUDGET=600
